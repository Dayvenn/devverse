{
  "expo": {
    "name": "devverse",
    "slug": "devverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "devverse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.kaene.devverse"
    },

    "web": {
      "output": "static"
    },

    "plugins": ["expo-router", "expo-font"],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "be1d4000-0b5b-4c68-862a-352ff39067bb"
      }
    }
  }
}
