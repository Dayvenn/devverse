generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  careers   Career[]
}

model Career {
  id           String   @id @default(uuid())
  status       String
  modalidade   String
  emprego      String
  experiencia  String
  avaliacao    String
  pretensao    String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}